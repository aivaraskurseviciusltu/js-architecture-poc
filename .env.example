# ─────────────────────────────────────────────────────────────────────────────
# Local development environment — copy to .env and adjust as needed.
# NEVER commit a .env file with real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=changeme
# Connection URI for nx serve (connects to local MongoDB on 27017).
# Docker compose uses 27018 to avoid conflicts with a locally-installed MongoDB.
# Use this if local MongoDB has no auth (default Homebrew install):
MONGODB_URI=mongodb://localhost:27017
# Use this if local MongoDB has auth enabled:
# MONGODB_URI=mongodb://root:changeme@localhost:27017

# ── AWS / LocalStack ──────────────────────────────────────────────────────────
# For local dev these are dummy values that LocalStack accepts.
# In production these are NOT set here — use IAM roles / IRSA.
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566

# ── LocalStack ────────────────────────────────────────────────────────────────
# Only required if you have a LocalStack Pro licence.
LOCALSTACK_AUTH_TOKEN=

# ── SNS / SQS (auto-created by localstack/init/01-create-resources.sh) ───────
SNS_ORDER_EVENTS_ARN=arn:aws:sns:us-east-1:000000000000:order-events
SQS_INVENTORY_QUEUE_URL=http://localhost:4566/000000000000/inventory-queue
SQS_NOTIFICATION_QUEUE_URL=http://localhost:4566/000000000000/notification-queue

# ── Service URLs (used when running services directly, not via docker compose) ─
ORDER_SERVICE_URL=http://localhost:3001

# ── BFF Security ──────────────────────────────────────────────────────────────
# Secret used to sign JWT tokens for local dev.
# ⚠ Change this to a long random string before deploying anywhere.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-secret-change-me-in-production

# Allowed CORS origin. Use * for local dev; set to your frontend URL in production.
CORS_ORIGIN=*

# ── Local dev users (optional — falls back to built-in alice/bob accounts) ────
# JSON array of user objects. Set this to override the default dev accounts.
# Format: [{"username":"alice","password":"alice123","sub":"u1","email":"alice@example.com","roles":["admin"]}]
# DEV_USERS=

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the BFF.
# For docker compose: http://localhost:3000
# For k8s local:      http://localhost:8080
VITE_BFF_URL=http://localhost:3000

# Auth mode: "local" (username/password form) or "cognito" (Hosted UI redirect).
# Default is "local" — do not set VITE_AUTH_MODE in local dev.
VITE_AUTH_MODE=local

# ── Cognito (only required when VITE_AUTH_MODE=cognito) ───────────────────────
# VITE_COGNITO_DOMAIN=my-app.auth.us-east-1.amazoncognito.com
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_REDIRECT_URI=https://app.yourdomain.com

# ── BFF: Cognito JWKS (only required when deploying to AWS with Cognito) ──────
# When set, the BFF validates JWTs against Cognito's public key instead of JWT_SECRET.
# JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/<userPoolId>/.well-known/jwks.json
